# Configurações do Flask
FLASK_APP=run.py
FLASK_DEBUG=True
# FLASK_CONFIG=config.DevelopmentConfig # Ou config.ProductionConfig, etc. Padrão é config.Config que lê outras .env vars.
SECRET_KEY='sua_chave_secreta_aqui_para_desenvolvimento_local'

# Credenciais do Administrador Principal (não armazenado no banco de dados)
ADMIN_EMAIL='admin@example.com'
ADMIN_PASSWORD='supersecretpassword'
# ADMIN_NOTIFICATIONS_EMAIL=${ADMIN_EMAIL} # E-mail para onde enviar notificações de aprovação, pode ser o mesmo ou outro.

# Configurações do Banco de Dados (para SQLAlchemy, se não for SQLite na pasta instance)
# DATABASE_URL='postgresql://user:password@host:port/database'

# Configurações do Servidor de E-mail (Flask-Mail)
MAIL_SERVER='smtp.example.com'
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME='seu-email@example.com'
MAIL_PASSWORD='sua-senha-de-email'
MAIL_DEFAULT_SENDER='noreply@example.com' # Ou use o mesmo que MAIL_USERNAME

# Configurações de SSL para desenvolvimento (Flask run)
FLASK_USE_SSL=False # Mude para True para usar HTTPS com certificados locais
SSL_CERT_PATH='cert.pem' # Caminho para o arquivo de certificado (ex: cert.pem na raiz do projeto)
SSL_KEY_PATH='key.pem'   # Caminho para o arquivo de chave privada (ex: key.pem na raiz do projeto)

# Configurações de Host e Porta para Flask run
FLASK_RUN_HOST='127.0.0.1' # Mude para 0.0.0.0 para ser acessível na rede local
FLASK_RUN_PORT=5000

# Configurações Específicas da Aplicação
# CONFIRMATION_TOKEN_MAX_AGE=3600 # Já definido em config.py, mas pode ser sobrescrito por .env
# LOGIN_SESSION_MAX_AGE_HOURS=24 # Já definido em config.py

# Tipo de Firewall (informativo para a lógica da aplicação)
# FIREWALL_TYPE='ufw' # ou 'iptables'

# Para SESSION_COOKIE_SECURE, etc., são lidos por config.py e podem ser definidos aqui para sobrescrever os padrões de Config
# SESSION_COOKIE_SECURE=False # Para desenvolvimento HTTP
# SESSION_COOKIE_HTTPONLY=True
# SESSION_COOKIE_SAMESITE='Lax'
